# Copy required values into your ignored .env.local; never commit credentials.
# Use the intended non-production project for local and Preview verification.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=

# Optional private preview news discovery (server only). Empty disables discovery.
# Do not prefix with NEXT_PUBLIC_. See docs/SETUP.md for Vercel scopes and redeploy.
TAVILY_API_KEY=

# Optional server-only Sportradar Images subscription credential (separate from stats).
# Used by the bounded metadata probe; does not enable public image publication.
SPORTRADAR_IMAGES_API_KEY=

# Tinybird Forward SDK: server-only workspace credential and regional API URL.
# See docs/intelligence/tinybird-infrastructure.md. Empty values leave connection pending.
TINYBIRD_TOKEN=
TINYBIRD_URL=

# Server-only environment-isolated analytics and review workflow.
# Off by default. Do not reuse account-management/workspace-admin credentials.
# Never prefix these with NEXT_PUBLIC_. Configure secrets outside source control.
BLTZ_ANALYTICS_PIPELINE_ENABLED=false
# Production additionally requires VERCEL_ENV=production and this explicit gate.
BLTZ_ANALYTICS_PRODUCTION_ENABLED=false
BLTZ_ANALYTICS_ENVIRONMENT=development
BLTZ_ANALYTICS_WORKER_URL=
BLTZ_ANALYTICS_DISPATCH_SECRET=
# Optional authenticated production GET dispatcher; no schedule is created here.
CRON_SECRET=
# Optional server-only header for the fixed worker behind Vercel protection.
VERCEL_AUTOMATION_BYPASS_SECRET=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Set this to the same region as the token and both signing keys.
# US: https://qstash-us-east-1.upstash.io; EU: https://qstash-eu-central-1.upstash.io
QSTASH_URL=
TINYBIRD_ANALYTICS_URL=
TINYBIRD_ANALYTICS_INGEST_TOKEN=
TINYBIRD_ANALYTICS_QUERY_TOKEN=
BLTZ_INTELLIGENCE_WORKFLOWS_ENABLED=false
BLTZ_INTELLIGENCE_WORKFLOWS_PRODUCTION_ENABLED=false
BLTZ_INTELLIGENCE_WORKFLOWS_ENVIRONMENT=development
